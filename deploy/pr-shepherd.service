[Unit]
Description=Fix review threads and CI on open pull requests
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__MAFIA_USER__
Environment=HOME=/home/__MAFIA_USER__
Environment=PATH=/home/__MAFIA_USER__/.local/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/home/__MAFIA_USER__/.local/bin/pr-shepherd.sh
TimeoutStartSec=2h
MemoryMax=4G
KillMode=control-group
